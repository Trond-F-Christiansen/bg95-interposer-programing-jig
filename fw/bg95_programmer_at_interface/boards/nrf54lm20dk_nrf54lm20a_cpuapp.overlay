/*
 * AT interface to the nRF9151 on the nRF9151-MK-BG95 interposer
 * (Serial Modem UART0, 115200 8N1, no hardware flow control):
 *
 *   nRF54LM20 DK P1.03 (UART21 TX)  ->  nRF9151 P0.14 (RX)
 *   nRF54LM20 DK P1.04 (UART21 RX)  <-  nRF9151 P0.15 (TX)
 *   GND                              --  GND
 *
 * P1.03 and P1.04 are free GPIOs on the DK headers. The terminal is
 * UART20 (VCOM1).
 */

&pinctrl {
	uart21_default: uart21_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 3)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 4)>;
			bias-pull-up;
		};
	};

	uart21_sleep: uart21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 3)>,
				<NRF_PSEL(UART_RX, 1, 4)>;
			low-power-enable;
		};
	};
};

/ {
	aliases {
		at-uart = &uart20;
		sm-uart = &uart21;
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
};

/* Modem side: nRF9151 on the interposer. */
&uart21 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart21_default>;
	pinctrl-1 = <&uart21_sleep>;
	pinctrl-names = "default", "sleep";
};
